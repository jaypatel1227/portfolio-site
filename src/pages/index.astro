---
import Base from "../layouts/Base.astro";
import { site, xSocial } from "../data/site";
---

<Base>
  <section class="home">
    <p class="eyebrow">hello, folks</p>
    <h1>{site.name.toLowerCase()}</h1>
    <p class="lede">{site.jobTitle.toLowerCase()}</p>
    <p>
      i work at <a href={site.employer.url} rel="noopener noreferrer">{site.employer.name.toLowerCase()}</a> in {site.location.city.toLowerCase()} / {site.location.region.toLowerCase()}.
    </p>
    <p>
      {site.availability}
      <a href={xSocial.url} rel="me noopener noreferrer">reach out on x!</a>
    </p>
  </section>
</Base>
