---
import { islandNote } from "../../data/site";

---

<div class="island" aria-hidden="true">
  <canvas class="island-canvas"></canvas>
  <div class="island-vignette"></div>
</div>

<p class="island-hint" aria-hidden="true">wasd to wander / q e or drag to orbit / scroll or + − to zoom / esc to run home</p>
<p class="island-sr">
  this page contains a sprite-stack forest clearing. use the w a s d keys or arrow keys to
  move the little wanderer, shift to hurry, q and e or drag to orbit the camera, scroll or plus and minus to zoom, and escape
  to run home. approach the note on the old tree to read it.
</p>

<aside class="island-note" aria-label="note pinned to the old tree" hidden>
  <p>{islandNote}</p>
</aside>

<style>
  .island {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .island-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    transition: opacity 0.6s ease;
  }

  .island-canvas[data-walkable] {
    pointer-events: auto;
    cursor: grab;
  }

  .island-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to right, rgba(20, 17, 14, 0.72) 0%, rgba(20, 17, 14, 0.35) 26%, transparent 46%),
      linear-gradient(to bottom, rgba(20, 17, 14, 0.42) 0%, transparent 16%, transparent 82%, rgba(20, 17, 14, 0.5) 100%);
  }

  .island-hint {
    position: fixed;
    left: 50%;
    bottom: 1.1rem;
    transform: translateX(-50%);
    z-index: 2;
    margin: 0;
    pointer-events: none;
    font-size: 0.92rem;
    letter-spacing: 0.045em;
    color: var(--color-muted);
    opacity: 0.8;
    transition: opacity 0.7s ease;
  }

  @media (max-width: 63.99rem), (prefers-reduced-motion: reduce) {
    .island-hint {
      display: none;
    }
  }

  .island-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .island-note[hidden] { display: none; }
  .island-note {
    position: fixed;
    z-index: 5;
    top: 21%;
    right: 5%;
    width: min(24rem, 88vw);
    padding: 1.8rem;
    background: #e1d6b5;
    color: #302f3f;
    border: 4px solid #75616d;
    box-shadow: 8px 8px 0 #14212ce6, 12px 12px 0 #92aaa15c;
    font: 15px/1.7 ui-monospace, monospace;
  }
  .island-note p { margin: 0; }
</style>

<style is:global>
  body:has(.island) :is(.site-header, .site-footer, .site-main) { position: relative; z-index: 1; }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.85rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  body:has(.island) .site-header {
    animation: fade-in 0.9s ease both;
  }

  body:has(.island) .site-footer {
    animation: fade-in 1.1s ease 0.35s both;
  }

  body:has(.island) .home-intro > * {
    animation: rise 0.85s cubic-bezier(0.22, 0.8, 0.3, 1) both;
  }

  body:has(.island) .home-intro > :nth-child(1) { animation-delay: 0.05s; }
  body:has(.island) .home-intro > :nth-child(2) { animation-delay: 0.14s; }
  body:has(.island) .home-intro > :nth-child(3) { animation-delay: 0.24s; }
  body:has(.island) .home-intro > :nth-child(4) { animation-delay: 0.34s; }
  body:has(.island) .home-intro > :nth-child(5) { animation-delay: 0.44s; }

  /* the accent dot breathes, slowly */
  @keyframes dot-breathe {
    0%,
    100% {
      text-shadow: 0 0 0 rgba(242, 182, 76, 0);
    }
    50% {
      text-shadow: 0 0 0.7rem rgba(242, 182, 76, 0.35);
    }
  }

  body:has(.island) .name-dot {
    animation: dot-breathe 5s ease-in-out 1.2s infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    body:has(.island) .site-header,
    body:has(.island) .site-footer,
    body:has(.island) .home-intro > *,
    body:has(.island) .name-dot {
      animation: none;
    }
  }

  @media (min-width: 700px) {
    body:has(.island) .home-intro { max-width: min(44vw, 38rem); }
  }

  body[data-island]:not([data-island="rest"]) .island-hint {
    opacity: 0;
  }

  .home-intro {
    transition: opacity 0.18s ease;
  }

  .vapor-word {
    display: inline-block;
    transition: opacity 0.65s ease, filter 0.85s ease, transform 0.85s cubic-bezier(0.22, 0.8, 0.3, 1);
    transition-delay: var(--vapor-delay);
  }

  .home .home-intro a { text-decoration: none; }
  .home-intro a .vapor-word { text-decoration: underline; text-underline-offset: 0.18em; }

  body:is([data-island="engaged"], [data-island="away"]) .vapor-word {
    opacity: 0;
    filter: blur(9px);
    transform: translateY(-2.2rem);
  }

  body[data-island]:is([data-island="engaged"], [data-island="away"]) .home-intro,
  body[data-island]:is([data-island="engaged"], [data-island="away"]) .home-intro a {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .vapor-word { transition: none; }
    body:is([data-island="engaged"], [data-island="away"]) .vapor-word { opacity: 1; filter: none; transform: none; }
    body:is([data-island="engaged"], [data-island="away"]) .home-intro { opacity: 0; }
  }

  body:has(.island) .site-main {
    pointer-events: none;
  }

  body:has(.island) .site-main a {
    pointer-events: auto;
  }

  body:has(.island) .site-footer {
    position: relative;
    border-top-color: transparent;
  }

  body:has(.island) .site-footer::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(244, 239, 230, 0.1) 16%,
      rgba(244, 239, 230, 0.16) 50%,
      rgba(244, 239, 230, 0.1) 84%,
      transparent
    );
  }
</style>

<script>
  import { bootIsland } from "../../lib/art/island/boot";

  const canvas = document.querySelector<HTMLCanvasElement>("canvas.island-canvas");
  if (canvas) {
    const dispose = bootIsland(canvas, document.querySelector<HTMLElement>(".island-note"));
    import.meta.hot?.dispose(dispose);
  }
</script>
