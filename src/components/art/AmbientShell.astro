---
/**
 * Shared shell for the ambient art studies: a fixed, full-viewport,
 * pointer-transparent layer with a softening veil on top. Each study
 * supplies its own canvas + boot script.
 */
---

<div class="ambient" aria-hidden="true">
  <slot />
  <div class="ambient-veil"></div>
</div>

<style>
  .ambient {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .ambient :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* soften the edges so the page content always sits in calm air */
  .ambient-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 50% 20%, transparent 40%, rgba(20, 17, 14, 0.55) 100%),
      linear-gradient(to bottom, rgba(20, 17, 14, 0.35), transparent 18%, transparent 70%, rgba(20, 17, 14, 0.5));
  }
</style>
