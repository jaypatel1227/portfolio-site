---
/**
 * "The Dark Glade" — the ambient piece behind the home hero.
 *
 * A walkable three.js glade: a fogged conifer forest with one enormous
 * old tree, a moonlit sky, mist and fireflies. the hero text
 * evaporates once you start to wander.
 *
 * wasd / arrows walk immediately (first step quietly grabs pointer
 * lock for fps look, drag-to-look as fallback), shift to hurry,
 * escape to drift back to the hero framing.
 *
 * Reduced motion renders a single composed frame. Paused
 * off-screen / hidden. DPR capped at 2. Canvas is aria-hidden;
 * controls are exposed as real text for assistive tech.
 */
interface Props {
  seed?: number;
}

const { seed = 2026 } = Astro.props;
---

<div class="glade" aria-hidden="true">
  <canvas class="glade-canvas" data-seed={seed}></canvas>
  <div class="glade-vignette"></div>
</div>

<p class="glade-hint" aria-hidden="true">wasd to wander / drag to look / esc to drift back</p>
<p class="glade-sr">
  this page contains an explorable first person glade you can walk through. use the w a s d
  keys or arrow keys to walk, shift to hurry, drag the scene to look around, and escape to
  drift back to the top of the page.
</p>

<style>
  .glade {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .glade-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: auto;
    cursor: grab;
    transition: opacity 0.6s ease;
  }

  /* settle the edges so the hero copy always sits in calm air */
  .glade-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to right, rgba(20, 17, 14, 0.72) 0%, rgba(20, 17, 14, 0.35) 26%, transparent 46%),
      linear-gradient(to bottom, rgba(20, 17, 14, 0.42) 0%, transparent 16%, transparent 82%, rgba(20, 17, 14, 0.5) 100%);
  }

  .glade-hint {
    position: fixed;
    left: 50%;
    bottom: 1.1rem;
    transform: translateX(-50%);
    z-index: 2;
    margin: 0;
    pointer-events: none;
    font-size: 0.92rem;
    letter-spacing: 0.045em;
    color: var(--color-muted);
    opacity: 0.8;
    transition: opacity 0.7s ease;
  }

  @media (max-width: 63.99rem) {
    .glade-hint {
      display: none;
    }
  }

  :global(body.glade-wandering) .glade-hint,
  :global(body.glade-drifting) .glade-hint {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .glade-hint {
      display: none;
    }
  }

  .glade-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { bootGlade } from "../../lib/art/glade";

  const boot = (): void => {
    document.querySelectorAll<HTMLCanvasElement>("canvas[data-seed].glade-canvas").forEach(bootGlade);
  };

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
  else requestAnimationFrame(boot);
</script>
