---
/**
 * "The Dark Glade": the ambient piece behind the home hero.
 *
 * A walkable three.js glade; the hero text evaporates once you start to
 * wander. Narrow screens and reduced motion get one composed still frame.
 * The scene lives in src/lib/art/glade; this file is its markup and
 * everything the page does in response to it.
 *
 * The canvas is aria-hidden; the controls are exposed as real text for
 * assistive tech.
 */
---

<div class="glade" aria-hidden="true">
  <canvas class="glade-canvas"></canvas>
  <div class="glade-vignette"></div>
</div>

<p class="glade-hint" aria-hidden="true">wasd to wander / drag to look / esc to drift back</p>
<p class="glade-sr">
  this page contains an explorable first person glade you can walk through. use the w a s d
  keys or arrow keys to walk, shift to hurry, drag the scene to look around, and escape to
  drift back to the top of the page.
</p>

<style>
  .glade {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .glade-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    transition: opacity 0.6s ease;
  }

  /* a still frame never intercepts scrolling or taps */
  .glade-canvas[data-walkable] {
    pointer-events: auto;
    cursor: grab;
  }

  /* settle the edges so the hero copy always sits in calm air */
  .glade-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to right, rgba(20, 17, 14, 0.72) 0%, rgba(20, 17, 14, 0.35) 26%, transparent 46%),
      linear-gradient(to bottom, rgba(20, 17, 14, 0.42) 0%, transparent 16%, transparent 82%, rgba(20, 17, 14, 0.5) 100%);
  }

  .glade-hint {
    position: fixed;
    left: 50%;
    bottom: 1.1rem;
    transform: translateX(-50%);
    z-index: 2;
    margin: 0;
    pointer-events: none;
    font-size: 0.92rem;
    letter-spacing: 0.045em;
    color: #bfa78a;
    opacity: 0.8;
    transition: opacity 0.7s ease;
  }

  /* the walk is offered on the same terms the script uses: see lib/art/glade/index.ts */
  @media (max-width: 63.99rem), (prefers-reduced-motion: reduce) {
    .glade-hint {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .glade-vignette {
      background: linear-gradient(to bottom, rgba(20, 12, 10, 0.65), rgba(20, 12, 10, 0.55) 34%, transparent 62%, rgba(20, 12, 10, 0.4));
    }
  }

  .glade-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<!-- how the rest of the page behaves while the glade is on it. the walk
     reports its phase as body[data-glade]: rest, engaged, away, drifting -->
<style is:global>
  body[data-glade]:not([data-glade="rest"]) .glade-hint {
    opacity: 0;
  }

  /* the hero text evaporates once you wander off */
  .home-intro {
    transition:
      opacity 1.15s cubic-bezier(0.4, 0, 0.2, 1),
      filter 1.15s cubic-bezier(0.4, 0, 0.2, 1),
      transform 1.15s cubic-bezier(0.4, 0, 0.2, 1);
  }

  body[data-glade="away"] .home-intro {
    opacity: 0;
    filter: blur(12px);
    transform: translateY(-1.1rem) scale(0.982);
    pointer-events: none;
  }

  /* let clicks fall through the copy layer to the canvas; links stay clickable */
  body:has(.glade) .site-main {
    pointer-events: none;
  }

  body:has(.glade) .site-main a {
    pointer-events: auto;
  }

  /* the footer overlays the scene; a full-strength hairline cuts a hard
     seam across the landscape, so fade the divider into the dark instead */
  body:has(.glade) .site-footer {
    position: relative;
    border-top-color: transparent;
  }

  body:has(.glade) .site-footer::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(244, 239, 230, 0.1) 16%,
      rgba(244, 239, 230, 0.16) 50%,
      rgba(244, 239, 230, 0.1) 84%,
      transparent
    );
  }
</style>

<script>
  import { bootGlade } from "../../lib/art/glade";

  const canvas = document.querySelector<HTMLCanvasElement>("canvas.glade-canvas");
  if (canvas) bootGlade(canvas);
</script>
