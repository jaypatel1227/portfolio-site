---
/**
 * "Kiln Filament": the ambient shader behind every page but home, on
 * phone-sized screens. A fixed, full-viewport, pointer-transparent layer
 * with a softening veil on top. see src/lib/art/filament.ts.
 */
---

<div class="filament" aria-hidden="true">
  <canvas class="filament-canvas"></canvas>
  <div class="filament-veil"></div>
</div>

<style>
  .filament {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .filament-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* soften the edges so the page content always sits in calm air */
  .filament-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 50% 20%, transparent 40%, rgba(20, 17, 14, 0.55) 100%),
      linear-gradient(to bottom, rgba(20, 17, 14, 0.35), transparent 18%, transparent 70%, rgba(20, 17, 14, 0.5));
  }
</style>

<script>
  import { bootFilament } from "../../lib/art/filament";

  const canvas = document.querySelector<HTMLCanvasElement>("canvas.filament-canvas");
  if (canvas) bootFilament(canvas);
</script>
