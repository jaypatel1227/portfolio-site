---
import "../styles/global.css";
import {
  absUrl,
  jsonLdGraph,
  site,
  type SeoImage,
} from "../data/site";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  image?: SeoImage | null;
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title = site.title,
  description = site.description,
  ogType = "website",
  image,
  publishedTime,
  modifiedTime,
  jsonLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const pageTitle = title === site.title ? site.title : `${title} · ${site.title}`;
const resolvedImage = image === null ? undefined : (image ?? site.shareImage);
const ogImageUrl = resolvedImage ? absUrl(resolvedImage.url) : undefined;
const twitterImageUrl = resolvedImage
  ? absUrl(resolvedImage.twitterUrl ?? resolvedImage.url)
  : undefined;
const schema = jsonLdGraph(jsonLd);
const path = Astro.url.pathname;
const year = new Date().getFullYear();

const nav = [
  { href: "/", label: "home", active: path === "/" },
  {
    href: "/blog",
    label: "blog",
    active: path === "/blog" || path.startsWith("/blog/") || path.startsWith("/posts/"),
  },
  { href: "/about", label: "about", active: path === "/about" || path.startsWith("/about/") },
];
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={site.themeColor} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.shortName}'s blog`}
      href={new URL("/rss.xml", site.url).href}
    />
    <link type="text/plain" rel="author" href="/humans.txt" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:locale" content="en_US" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {resolvedImage && <meta property="og:image:alt" content={resolvedImage.alt} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@jaypa_dot_tel" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {twitterImageUrl && <meta name="twitter:image" content={twitterImageUrl} />}
    {resolvedImage && <meta name="twitter:image:alt" content={resolvedImage.alt} />}

    {
      publishedTime && (
        <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />
      )
    }
    {ogType === "article" && <meta property="article:author" content={site.author} />}

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="font-hand min-h-dvh flex flex-col">
    <a class="skip-link" href="#content">skip to the good part</a>
    <header class="site-header">
      <a class="wordmark" href="/">{site.siteName}</a>
      <nav aria-label="primary">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={item.active ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="content" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-links">
        {
          site.socials.map((social) => (
            <a href={social.url} rel="me noopener noreferrer" target="_blank">
              {social.label}
            </a>
          ))
        }
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href="/rss.xml">rss</a>
        <a href="/humans.txt">humans</a>
      </p>
      <p class="footer-copy">
        © {year} {site.name.toLowerCase()}. {site.copyright.toLowerCase()}.
      </p>
    </footer>
  </body>
</html>
